# Copy this file to .env and fill in the values you need.
# .env is already git-ignored.

# The Odds API (https://the-odds-api.com) - free tier, no card needed.
# Used by mlb_props_main.py; checked before BETSTAMP_API_KEY.
# Not needed when running with --mock.
ODDS_API_KEY=

# Betstamp API (https://www.betstamp.com/sports-betting-api) - used by
# odds_monitor's main.py, and as a fallback by mlb_props_main.py if
# ODDS_API_KEY isn't set. Not needed when running with --mock.
BETSTAMP_API_KEY=

# Discord notifications (optional). Enable with --notify discord.
# Create a webhook: Channel Settings -> Integrations -> Webhooks.
DISCORD_WEBHOOK_URL=

# Email notifications via SMTP (optional). Enable with --notify email.
# For Gmail, SMTP_PASSWORD must be an app password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
